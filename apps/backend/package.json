{
  "name": "backend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "lint": "oxlint",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@repo/shared-types": "workspace:*",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "oxlint": "^0.16.5",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.0"
  }
}